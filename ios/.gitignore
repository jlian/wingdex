# Xcode
*.xcuserdata
*.xcworkspace
!WingDex.xcworkspace/
WingDex.xcworkspace/*
!WingDex.xcworkspace/contents.xcworkspacedata
!WingDex.xcworkspace/xcshareddata/
WingDex.xcworkspace/xcshareddata/*
!WingDex.xcworkspace/xcshareddata/swiftpm/
WingDex.xcworkspace/xcshareddata/swiftpm/*
!WingDex.xcworkspace/xcshareddata/swiftpm/Package.resolved
# Track the generated WingDex scheme for CodeQL autobuild. Regenerate it from
# project.yml instead of accepting Xcode's local scheme rewrites.
WingDex.xcodeproj/xcshareddata/xcschemes/*
!WingDex.xcodeproj/xcshareddata/xcschemes/WingDex.xcscheme
!WingDex.xcodeproj/project.xcworkspace/
WingDex.xcodeproj/project.xcworkspace/*
!WingDex.xcodeproj/project.xcworkspace/contents.xcworkspacedata
!WingDex.xcodeproj/project.xcworkspace/xcshareddata/
WingDex.xcodeproj/project.xcworkspace/xcshareddata/*
!WingDex.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
WingDex.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!WingDex.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
xcuserdata/
DerivedData/
build/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

